rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function postoPath(postoId) {
      return /databases/$(database)/documents/postos/$(postoId);
    }

    function patientPath(patientId) {
      return /databases/$(database)/documents/pacientes/$(patientId);
    }

    function hasProfile() {
      return signedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function activeUser() {
      return hasProfile() && profile().ativo == true;
    }

    function isAdmin() {
      return activeUser() && profile().role == 'admin';
    }

    function isPostoProfile() {
      return activeUser()
        && profile().role == 'posto'
        && profile().postoId is string;
    }

    function isActivePostoUser() {
      return isPostoProfile()
        && exists(postoPath(profile().postoId))
        && get(postoPath(profile().postoId)).data.ativo == true;
    }

    function samePosto(postoId) {
      return isActivePostoUser() && profile().postoId == postoId;
    }

    match /usuarios/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.nome is string
        && request.resource.data.email is string
        && request.resource.data.role in ['admin', 'posto']
        && request.resource.data.ativo is bool
        && (
          request.resource.data.role == 'admin'
          || request.resource.data.postoId is string
        )
        && (
          uid != request.auth.uid
          || (
            request.resource.data.role == 'admin'
            && request.resource.data.ativo == true
          )
        );

      allow delete: if false;
    }

    match /postos/{postoId} {
      allow read: if activeUser()
        && (
          isAdmin()
          || (isPostoProfile() && profile().postoId == postoId)
        );

      allow create, update: if isAdmin()
        && request.resource.data.nome is string
        && request.resource.data.ativo is bool;

      allow delete: if false;
    }

    // Diretório mínimo da rede. Permite localizar um cidadão e sua unidade,
    // sem liberar o prontuário clínico de outro posto.
    match /pacientes_index/{indexId} {
      allow read: if isAdmin() || isActivePostoUser();

      allow create: if activeUser()
        && request.resource.data.nome is string
        && request.resource.data.postoId is string
        && request.resource.data.dataNascimento is string
        && request.resource.data.ativo is bool
        && (isAdmin() || samePosto(request.resource.data.postoId));

      allow update: if activeUser()
        && request.resource.data.nome is string
        && request.resource.data.postoId is string
        && request.resource.data.dataNascimento is string
        && request.resource.data.ativo is bool
        && (
          isAdmin()
          || (
            samePosto(resource.data.postoId)
            && request.resource.data.postoId == resource.data.postoId
          )
        );

      allow delete: if false;
    }

    match /pacientes/{patientId} {
      allow read: if activeUser()
        && (isAdmin() || samePosto(resource.data.postoId));

      allow create: if activeUser()
        && request.resource.data.postoId is string
        && request.resource.data.nome is string
        && request.resource.data.programas is list
        && request.resource.data.ativo is bool
        && request.resource.data.criadoPor == request.auth.uid
        && (isAdmin() || samePosto(request.resource.data.postoId));

      allow update: if activeUser()
        && request.resource.data.postoId is string
        && request.resource.data.nome is string
        && request.resource.data.programas is list
        && request.resource.data.ativo is bool
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['criadoEm', 'criadoPor'])
        && (
          isAdmin()
          || (
            samePosto(resource.data.postoId)
            && request.resource.data.postoId == resource.data.postoId
          )
        );

      allow delete: if false;
    }

    match /historico/{historyId} {
      allow read: if activeUser()
        && (isAdmin() || samePosto(resource.data.postoId));

      allow create: if activeUser()
        && request.resource.data.patientId is string
        && request.resource.data.postoId is string
        && request.resource.data.acao is string
        && request.resource.data.resumo is string
        && request.resource.data.userId == request.auth.uid
        && exists(patientPath(request.resource.data.patientId))
        && get(patientPath(request.resource.data.patientId)).data.postoId == request.resource.data.postoId
        && (isAdmin() || samePosto(request.resource.data.postoId));

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
